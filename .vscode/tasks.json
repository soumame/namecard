{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "FW: Configure external-power-self-test",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "external-power-self-test"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "problemMatcher": []
    },
    {
      "label": "FW: Build external-power-self-test",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "external-power-self-test"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "dependsOn": "FW: Configure external-power-self-test",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "FW: Configure nfc-fixed-test",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "nfc-fixed-test"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "problemMatcher": []
    },
    {
      "label": "FW: Configure prepare-white",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "prepare-white"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "problemMatcher": []
    },
    {
      "label": "FW: Build prepare-white",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "prepare-white"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "dependsOn": "FW: Configure prepare-white",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "FW: Build nfc-fixed-test",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "nfc-fixed-test"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "dependsOn": "FW: Configure nfc-fixed-test",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "FW: Configure nfc-fixed-one-shot",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "nfc-fixed-one-shot"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "problemMatcher": []
    },
    {
      "label": "FW: Build nfc-fixed-one-shot",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "nfc-fixed-one-shot"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "dependsOn": "FW: Configure nfc-fixed-one-shot",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "FW: Configure release",
      "type": "process",
      "command": "cmake",
      "args": ["--preset", "release"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "problemMatcher": []
    },
    {
      "label": "FW: Build release",
      "type": "process",
      "command": "cmake",
      "args": ["--build", "--preset", "release"],
      "options": { "cwd": "${workspaceFolder}/firmware" },
      "dependsOn": "FW: Configure release",
      "dependsOrder": "sequence",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "FW: Provision BOR3 (2.5V falling)",
      "detail": "STM32G031 option bytesを一度だけ設定。EPDは外し、外部3.3VとST-Linkを使用する",
      "type": "process",
      "command": "arch",
      "args": [
        "-x86_64",
        "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin/STM32_Programmer_CLI",
        "-c", "port=SWD", "freq=1000", "mode=UR", "reset=HWrst",
        "-ob", "BOR_EN=1", "BORF_LEV=2", "BORR_LEV=2",
        "-rst"
      ],
      "problemMatcher": []
    },
    {
      "label": "FW: Flash external-power-self-test",
      "detail": "v4実装・FPC確認後、EPD接続＋外部3.3VでFull→Partialを確認する",
      "type": "process",
      "command": "arch",
      "args": [
        "-x86_64",
        "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin/STM32_Programmer_CLI",
        "-c", "port=SWD", "freq=1000", "mode=UR", "reset=HWrst",
        "-w", "${workspaceFolder}/firmware/build/self-test/namecard_fw.hex",
        "-v", "-rst"
      ],
      "dependsOn": "FW: Build external-power-self-test",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "FW: Flash nfc-fixed-test",
      "detail": "v4用3.20V開始・8行分割フォールバック。書き込み後はST-Linkと外部電源を完全に外す",
      "type": "process",
      "command": "arch",
      "args": [
        "-x86_64",
        "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin/STM32_Programmer_CLI",
        "-c", "port=SWD", "freq=1000", "mode=UR", "reset=HWrst",
        "-w", "${workspaceFolder}/firmware/build/nfc-fixed-test/namecard_fw.hex",
        "-v", "-halt"
      ],
      "dependsOn": "FW: Build nfc-fixed-test",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "FW: Flash nfc-fixed-one-shot",
      "detail": "v4の主試験。基板上VRESだけで3.20V充電後、全画面Partialを1回実行する",
      "type": "process",
      "command": "arch",
      "args": [
        "-x86_64",
        "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin/STM32_Programmer_CLI",
        "-c", "port=SWD", "freq=1000", "mode=UR", "reset=HWrst",
        "-w", "${workspaceFolder}/firmware/build/nfc-fixed-one-shot/namecard_fw.hex",
        "-v", "-halt"
      ],
      "dependsOn": "FW: Build nfc-fixed-one-shot",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "FW: Flash prepare-white",
      "detail": "量産初期化: 外部3.3VでEH_MODE=0/FTM許可を設定し、Full白表示とFlash基準画像を揃える",
      "type": "process",
      "command": "arch",
      "args": [
        "-x86_64",
        "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin/STM32_Programmer_CLI",
        "-c", "port=SWD", "freq=1000", "mode=UR", "reset=HWrst",
        "-w", "${workspaceFolder}/firmware/build/prepare-white/namecard_fw.hex",
        "-v", "-rst"
      ],
      "dependsOn": "FW: Build prepare-white",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "FW: Flash release",
      "detail": "STATUS・1-byte内蔵パターン・分割画像転送に対応するMailbox版",
      "type": "process",
      "command": "arch",
      "args": [
        "-x86_64",
        "/Applications/STMicroelectronics/STM32Cube/STM32CubeProgrammer/STM32CubeProgrammer.app/Contents/Resources/bin/STM32_Programmer_CLI",
        "-c", "port=SWD", "freq=1000", "mode=UR", "reset=HWrst",
        "-w", "${workspaceFolder}/firmware/build/release/namecard_fw.hex",
        "-v", "-rst"
      ],
      "dependsOn": "FW: Build release",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Android: Build NFC test client",
      "detail": "画像エディターと4736-byte分割転送を含む試験APKを作成する",
      "type": "process",
      "command": "${workspaceFolder}/client/android/gradlew",
      "args": [":app:assembleDebug", "--no-daemon"],
      "options": {
        "cwd": "${workspaceFolder}/client/android",
        "env": {
          "ANDROID_HOME": "${env:HOME}/Library/Android/sdk"
        }
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Android: Install NFC test client",
      "detail": "USBデバッグ接続したAndroid端末へdebug APKを上書きインストールする",
      "type": "process",
      "command": "${env:HOME}/Library/Android/sdk/platform-tools/adb",
      "args": [
        "install", "-r",
        "${workspaceFolder}/client/android/app/build/outputs/apk/debug/app-debug.apk"
      ],
      "dependsOn": "Android: Build NFC test client",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Android: Remove incompatible NFC test client",
      "detail": "署名不一致の旧テストアプリとアプリデータを端末から削除する",
      "type": "process",
      "command": "${env:HOME}/Library/Android/sdk/platform-tools/adb",
      "args": ["uninstall", "work.tokumaru.namecard"],
      "problemMatcher": []
    },
    {
      "label": "Android: Clean install NFC test client (signature reset)",
      "detail": "APKをビルドし、署名不一致の旧版を削除して新しいdebug APKをインストールする",
      "type": "process",
      "command": "${env:HOME}/Library/Android/sdk/platform-tools/adb",
      "args": [
        "install",
        "${workspaceFolder}/client/android/app/build/outputs/apk/debug/app-debug.apk"
      ],
      "dependsOn": [
        "Android: Build NFC test client",
        "Android: Remove incompatible NFC test client"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Tools: Generate sample native image",
      "detail": "分割転送用の4736-byteチェック柄を/tmpへ生成する",
      "type": "process",
      "command": "python3",
      "args": [
        "${workspaceFolder}/firmware/tools/namecard_protocol.py",
        "make-image", "--pattern", "checker",
        "--output", "/tmp/namecard-checker.bin"
      ],
      "problemMatcher": []
    },
    {
      "label": "Android: Push sample native image",
      "detail": "分割転送用チェック柄をAndroidのDownloadへコピーする",
      "type": "process",
      "command": "${env:HOME}/Library/Android/sdk/platform-tools/adb",
      "args": ["push", "/tmp/namecard-checker.bin", "/sdcard/Download/namecard-checker.bin"],
      "dependsOn": "Tools: Generate sample native image",
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
